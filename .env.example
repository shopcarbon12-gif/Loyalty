# Carbon Loyalty — environment variables.
# Copy this file to .env.local for local dev.
# In production, set these in the Coolify UI for the loyalty.shopcarbon.com app.

# Same Postgres as Carbon-POS and Carbon-WMS.
# Production: use the internal Coolify hostname iogw84scwo0owsco8c8wg4s0:5432.
# Laptop dev: 152.53.210.171:2040 (open via Coolify when needed).
DATABASE_URL=

# 32-byte random string. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:5100

# Shared API key Carbon-POS uses to call the loyalty service.
# 64-byte random hex. Generate with: openssl rand -hex 32
LOYALTY_API_KEY=

# HMAC secret used for verifying Shopify app-proxy + webhook requests.
# Same value as CarbonWMS's SHOPIFY_WEBHOOK_SECRET (the Shopify app's
# client secret).
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-01

# Admin API access — same pair CarbonWMS uses. Needed to link customers
# and push balances to the loyalty.balance customer metafield.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Email transactional sender (Resend). Same key Carbon-POS uses.
RESEND_API_KEY=
LOYALTY_FROM_EMAIL=loyalty@shopcarbon.com
